{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P2PShare",
  "version": "3.4.6",
  "identifier": "com.p2pshare.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "P2P Share",
        "width": 380,
        "height": 600,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "backgroundColor": "#000000",
        "additionalBrowserArgs": "--disable-gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCRjc3NzU0MENENzgzNDQKUldSRWc5Y01WSGYzR3dUVkt6cHFkcUNEUlg3YjFleGF5amtqMmV0dWtUYm0vUEpCREpWOEN1bXUK",
      "endpoints": ["https://github.com/lamziiii/P2P-Sender/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "desktop": { "schemes": ["p2pshare"] },
      "mobile": [{ "scheme": ["p2pshare"] }]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage"],
    "category": "Utility",
    "shortDescription": "Partage de fichiers et chat en pair-à-pair",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["French", "English"] }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
